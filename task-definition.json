{
  "family": "url-shortener-task",
  "containerDefinitions": [
    {
      "name": "url-shortener",
      "image": "arshadkhan007/url-shortener:latest",
      "cpu": 0,
      "portMappings": [
        {
          "name": "url-shortener-port",
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "essential": true,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/url-shortener",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ],
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::030172395360:role/ecsTaskExecutionRole"
}