# --- App DB connection (compose service name is "db") ---
DB_HOST=db
DB_PORT=3306
DB_USER=your_username
DB_PASSWORD=changeme_app_password
DB_NAME=your_database_name

# --- MySQL container init (docker-compose only) ---
MYSQL_ROOT_PASSWORD=changeme_root_password
MYSQL_DATABASE=your_database_name
MYSQL_USER=your_username
MYSQL_PASSWORD=changeme_app_password

# --- App ---
BASE_URL=http://localhost:8000